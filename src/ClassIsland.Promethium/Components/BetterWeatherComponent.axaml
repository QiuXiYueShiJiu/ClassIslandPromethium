<controls:ComponentBase x:TypeArguments="models:BetterWeatherSettings"
                        x:Class="ClassIsland.Promethium.Components.BetterWeatherComponent"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        xmlns:models="clr-namespace:ClassIsland.Promethium.Models"
                        xmlns:ci="http://classisland.tech/schemas/xaml/core"
                        mc:Ignorable="d"
                        ClipToBounds="False">
    <StackPanel x:Name="Root"
                Orientation="Horizontal"
                Spacing="6"
                Classes="items-valign-center">
        <!-- 图标：四种画法互斥，靠 ViewModel 里的可见性开关切 -->
        <ci:FluentIcon Glyph="{Binding IconGlyph}"
                       IsVisible="{Binding ShowGlyph}"
                       Height="22" Width="22" FontSize="22"
                       VerticalAlignment="Center" />
        <TextBlock Text="{Binding IconEmoji}"
                   IsVisible="{Binding ShowEmoji}"
                   FontFamily="{Binding IconFont}"
                   FontSize="20"
                   VerticalAlignment="Center" />
        <Image Source="{Binding IconImage}"
               IsVisible="{Binding ShowImage}"
               Height="{Binding IconImageHeight}"
               VerticalAlignment="Center" />

        <TextBlock Text="{Binding TemperatureText}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ConditionText}"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource MainWindowSecondaryFontSize}" />
        <TextBlock Text="{Binding TodayRangeText}"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource MainWindowSecondaryFontSize}"
                   IsVisible="{Binding ShowDailyRangeEffective}" />
        <TextBlock Text="{Binding HumidityText}"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource MainWindowSecondaryFontSize}"
                   IsVisible="{Binding ShowHumidityEffective}" />
        <TextBlock Text="{Binding WindText}"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource MainWindowSecondaryFontSize}"
                   IsVisible="{Binding ShowWindEffective}" />
        <TextBlock Text="{Binding FeelsLikeText}"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource MainWindowSecondaryFontSize}"
                   IsVisible="{Binding ShowFeelsLikeEffective}" />
        <TextBlock Text="{Binding Config.LocationName}"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource MainWindowSecondaryFontSize}"
                   IsVisible="{Binding ShowLocationNameEffective}" />

        <!-- 报警：只显示检测器真实判定出来的结果，检测不到就不显示 -->
        <ci:FluentIcon Glyph="{Binding WeatherAlertGlyph}"
                       IsVisible="{Binding Alerts.HasWeatherAlert}"
                       Height="18" Width="18" FontSize="18"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
        <TextBlock Text="{Binding Alerts.WeatherAlertText}"
                   IsVisible="{Binding Alerts.HasWeatherAlert}"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource MainWindowSecondaryFontSize}"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
        <ci:FluentIcon Glyph="{Binding EarthquakeAlertGlyph}"
                       IsVisible="{Binding Alerts.HasEarthquakeAlert}"
                       Height="18" Width="18" FontSize="18"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <TextBlock Text="{Binding Alerts.EarthquakeAlertText}"
                   IsVisible="{Binding Alerts.HasEarthquakeAlert}"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource MainWindowSecondaryFontSize}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

        <TextBlock Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource MainWindowSecondaryFontSize}"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
    </StackPanel>
</controls:ComponentBase>
