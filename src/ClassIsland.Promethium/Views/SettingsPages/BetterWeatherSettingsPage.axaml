<ci:SettingsPageBase x:Class="ClassIsland.Promethium.Views.SettingsPages.BetterWeatherSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:pm="clr-namespace:ClassIsland.Promethium.Controls"
                     mc:Ignorable="d"
                     d:DesignHeight="700" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Root" Spacing="10" Margin="0,0,0,24">

            <fa:InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                        Message="天气数据来自 Open-Meteo（直接按经纬度查询，无需密钥）；地图瓦片与地名来自 OpenStreetMap。这里选的位置是全局的，主界面上所有「更好的天气」组件都用它。" />

            <Border CornerRadius="8" ClipToBounds="True" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Height="340">
                <Grid>
                    <pm:MapPicker x:Name="Map" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="6" Padding="5,2" CornerRadius="4"
                            Background="#99000000">
                        <TextBlock Text="© OpenStreetMap 贡献者"
                                   FontSize="10" Foreground="White" />
                    </Border>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="6" Padding="7,3" CornerRadius="4"
                            Background="#99000000">
                        <TextBlock Text="点一下选点 · 拖动平移 · 滚轮缩放"
                                   FontSize="11" Foreground="White" />
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.85" />

            <fa:SettingsExpander Header="精确坐标"
                                 Description="可以直接填经纬度；改完会自动重新查天气。"
                                 IsExpanded="True">
                <fa:SettingsExpanderItem Content="纬度" Description="北纬为正，范围 -85 ~ 85。">
                    <fa:SettingsExpanderItem.Footer>
                        <fa:NumberBox Value="{Binding Config.Latitude, Mode=TwoWay}"
                                      Minimum="-85" Maximum="85"
                                      SmallChange="0.0001" LargeChange="0.01"
                                      SpinButtonPlacementMode="Compact"
                                      MinWidth="180" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="经度" Description="东经为正，范围 -180 ~ 180。">
                    <fa:SettingsExpanderItem.Footer>
                        <fa:NumberBox Value="{Binding Config.Longitude, Mode=TwoWay}"
                                      Minimum="-180" Maximum="180"
                                      SmallChange="0.0001" LargeChange="0.01"
                                      SpinButtonPlacementMode="Compact"
                                      MinWidth="180" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="地点名" Description="显示在组件上，一般由反查自动填写。">
                    <fa:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox Text="{Binding Config.LocationName, Mode=TwoWay}" MinWidth="220" />
                            <Button Content="重新反查" Command="{Binding LookupNameCommand}" />
                        </StackPanel>
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="按地名搜索"
                                 Description="搜中文地名，从结果里挑一个。反查和搜索都走 OpenStreetMap，一秒最多一次请求。">
                <fa:SettingsExpanderItem Content="搜索">
                    <fa:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox Text="{Binding SearchText, Mode=TwoWay}" MinWidth="220"
                                     Watermark="例如：某某中学" />
                            <Button Content="搜索" Command="{Binding SearchCommand}" />
                        </StackPanel>
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <ListBox x:Name="CandidateList"
                         ItemsSource="{Binding Candidates}"
                         MaxHeight="190"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontSize="12" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </fa:SettingsExpander>

            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                       Text="说明：预报本身是按格点算的，所谓「精确到街道」指的是这里显示的地点名能到街道一级，并不代表预报分辨率到了街道。" />
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
