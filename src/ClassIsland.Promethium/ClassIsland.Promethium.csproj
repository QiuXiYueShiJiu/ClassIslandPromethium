<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <OutputType>Library</OutputType>
        <AssemblyName>ClassIsland.Promethium</AssemblyName>
        <RootNamespace>ClassIsland.Promethium</RootNamespace>
        <Version>1.0.0.0</Version>
        <!-- 依赖一律用宿主已加载的那份，插件包里不能再带一份 -->
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
        <!--
          CS1591: 不强制给每个公开成员写 XML 注释。
          AVLN3001: 提示带参数的视图类无法被 avares:// 运行时加载器实例化。
                    宿主的插件全部由 DI 构造，XAML 走的是编译期路径，
                    这个警告对应的场景我们根本不走，实测已确认三个视图都能正常加载。
        -->
        <NoWarn>$(NoWarn);CS1591;AVLN3001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- ClassIsland.Core 由宿主提供，绝不能塞进 .cipx -->
        <PackageReference Include="ClassIsland.Core" Version="2.1.0"
                          PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Avalonia" Version="11.3.17"
                          PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="FluentAvaloniaUI" Version="2.4.1"
                          PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1"
                          PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <None Include="manifest.yml" CopyToOutputDirectory="PreserveNewest" />
        <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
        <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('icon.png')" />
    </ItemGroup>

</Project>
